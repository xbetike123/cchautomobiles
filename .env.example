# Supabase project credentials. Anon key is the only one safe to expose
# in the browser (RLS gates everything). Service role key is server-only.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# WhatsApp Cloud API. Server-only. Used by the quote request server action
# to notify the CCH operations number.
WHATSAPP_CLOUD_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_OPERATIONS_NUMBER=

# MailerLite. Server-only. Used by the market intel newsletter signup.
MAILERLITE_API_KEY=
MAILERLITE_GROUP_ID=

# Cloudflare Turnstile. Site key is rendered by a Server Component and
# passed to the Turnstile widget as a prop, so it does not need the
# NEXT_PUBLIC_ prefix. Secret key is server-only.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Resend transactional email. Server-only.
# - RESEND_API_KEY: Resend dashboard → API Keys.
# - RESEND_FROM_EMAIL: a sender on a domain you've verified in Resend.
# - RESEND_FROM_NAME: optional display name (defaults to "CCH Automobile").
# - RESEND_REPLY_TO_EMAIL: optional. If set, client replies land here.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
RESEND_FROM_NAME=
RESEND_REPLY_TO_EMAIL=

# Upstash Redis. Server-only. Backs the per-IP rate limit on the quote
# request route handler.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
