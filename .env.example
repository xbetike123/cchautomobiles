# Supabase project credentials. Anon key is the only one safe to expose
# in the browser (RLS gates everything). Service role key is server-only.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Admin dashboard authentication. Use a unique password of at least 12
# characters and an independent random session secret of at least 32 characters.
# Generate a session secret with: openssl rand -base64 48
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=

# WhatsApp Cloud API. Server-only. Used by the quote request server action
# to notify the CCH operations number.
WHATSAPP_CLOUD_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_OPERATIONS_NUMBER=

# MailerLite. Server-only. Used by the market intel newsletter signup.
MAILERLITE_API_KEY=
MAILERLITE_GROUP_ID=

# Resend transactional email. Server-only.
# - RESEND_API_KEY: Resend dashboard → API Keys.
# - RESEND_FROM_EMAIL: a sender on a domain you've verified in Resend.
# - RESEND_FROM_NAME: optional display name (defaults to "CCH Automobile").
# - RESEND_REPLY_TO_EMAIL: optional. If set, client replies land here.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
RESEND_FROM_NAME=
RESEND_REPLY_TO_EMAIL=

# Absolute URL for the logo shown in transactional emails. Emails can't load
# localhost or relative paths, so this must be publicly reachable.
# - Leave blank in production once the site is deployed: it defaults to
#   ${SITE_URL}/logo/cch_logo_email.png.
# - Before deploy, point it at a CDN / Supabase public bucket.
# - For local email previews: http://localhost:3000/logo/cch_logo_email.png
EMAIL_LOGO_URL=

# Discord webhook. Server-only. Posts a notification to the admin channel
# when a new consultation booking comes in. Create one in your Discord
# server: Channel → Edit → Integrations → Webhooks → New Webhook → Copy URL.
DISCORD_WEBHOOK_URL=

# Upstash Redis. Server-only. Backs the per-IP rate limit on the quote
# request route handler.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
